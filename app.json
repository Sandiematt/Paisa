{
  "expo": {
    "name": "Paisa",
    "slug": "paisa",
    "scheme": "paisa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E11",
    "ios": {
      "bundleIdentifier": "org.reactjs.native.example.expense-tracker",
      "supportsTablet": true,
      "backgroundColor": "#0E0E11"
    },
    "android": {
      "package": "com.expense_tracker",
      "backgroundColor": "#0E0E11"
    },
    "plugins": [
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Paisa uses Face ID to keep your finances locked."
        }
      ],
      "expo-web-browser",
      "expo-notifications"
    ]
  }
}
