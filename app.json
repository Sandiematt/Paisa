{
  "expo": {
    "name": "Paisa",
    "slug": "paisa",
    "scheme": "paisa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.reactjs.native.example.expense-tracker",
      "supportsTablet": true
    },
    "android": {
      "package": "com.expense_tracker"
    },
    "plugins": [
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Paisa uses Face ID to keep your finances locked."
        }
      ]
    ]
  }
}
