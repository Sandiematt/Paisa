<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#0E0E11</color>
    <color name="canvas">#0E0E11</color>

    <!-- Paisa design tokens, used by the UPI detector's overlays and note dialog. -->
