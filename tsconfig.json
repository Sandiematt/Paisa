{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // Per-icon imports resolve to Phosphor's .tsx sources (so Metro bundles only the
    // icons used); type-check against the package's shipped declarations instead.
    "paths": {
      "phosphor-react-native/src/icons/*": [
        "./node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "supabase/functions/**"]
}
